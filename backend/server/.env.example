# Copy this file to .env and enter your own database details.
PORT=5000
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=inn_management

# Example room charges in your local currency. Keep frontend values in sync.
RATE_UP_TO_3_HOURS=80
RATE_UP_TO_8_HOURS=150
RATE_UP_TO_24_HOURS=200
RATE_EACH_EXTRA_HOUR=20

# Comma-separated exact frontend origins.
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
