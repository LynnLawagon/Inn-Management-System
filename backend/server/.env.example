# Copy this file to .env and enter your own database details.
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=your_inn_database

# Example room charges in your local currency.
RATE_UP_TO_3_HOURS=80
RATE_UP_TO_8_HOURS=150
RATE_UP_TO_24_HOURS=200
RATE_EACH_EXTRA_HOUR=20

# Comma-separated frontend origin(s) for deployment.
CLIENT_ORIGINS=http://localhost:3000
